{
  "$defs": {
    "Bytes": {
      "contentEncoding": "base64",
      "description": "Binary payload encoded as a standard base64 string.",
      "type": "string"
    },
    "ScanItem": {
      "description": "KV scan item.",
      "properties": {
        "key": {
          "$ref": "#/$defs/Bytes"
        },
        "timestamp": {
          "description": "Logical commit-timeline position of the commit that wrote this value: a\nmonotonic per-commit counter (a fresh database starts small, near 1),\nnever a calendar date. Pass it to `--as-of` and match it against\n`history`; do not format it as a Unix/epoch timestamp.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "$ref": "#/$defs/Bytes"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "value",
        "version",
        "timestamp"
      ],
      "type": "object"
    }
  },
  "$id": "https://stratadb.org/idl/v1/schemas/kv.scan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "command": "kv.scan",
  "request": {
    "additionalProperties": false,
    "description": "Scans KV rows.\n\n# Guaranteed semantics\n\n- **One call, one read.** A scan returns its rows from a single read of\n  the branch; it does not paginate across calls, so no write can land\n  part-way through the result. Use `list` when you need cursored pages.\n- **Ordered and half-open.** Rows come back in ascending key order over\n  `[start, end)` — the start key is included, the end key is not.",
    "properties": {
      "branch": {
        "description": "Target branch. Defaults to the executor handle branch.",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "description": "Optional row limit.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "space": {
        "description": "Target product space. Defaults to `\"default\"`.",
        "type": [
          "string",
          "null"
        ]
      },
      "start": {
        "anyOf": [
          {
            "$ref": "#/$defs/Bytes"
          },
          {
            "type": "null"
          }
        ],
        "description": "Optional inclusive start key."
      },
      "type": {
        "const": "kv_scan",
        "type": "string"
      }
    },
    "required": [
      "type"
    ],
    "type": "object"
  },
  "response": {
    "description": "KV scan result.",
    "properties": {
      "data": {
        "description": "Shared pagination continuation facts.",
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "$ref": "#/$defs/Bytes"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "description": "Rows in this page.",
            "items": {
              "$ref": "#/$defs/ScanItem"
            },
            "type": "array"
          }
        },
        "required": [
          "items",
          "has_more"
        ],
        "type": "object"
      },
      "type": {
        "const": "kv_scan_result",
        "type": "string"
      }
    },
    "required": [
      "type",
      "data"
    ],
    "type": "object"
  }
}
